                        <ui:VisualElement name="Press" style="background-color: rgb(90, 217, 174); width: 100%; height: 100%; border-top-left-radius: 12px; border-bottom-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; position: absolute; display: none; visibility: visible;"/>
                        <ui:VisualElement name="Disable" style="background-color: rgb(118, 118, 118); width: 100%; height: 100%; border-top-left-radius: 12px; border-bottom-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; position: absolute; display: none; visibility: visible;"/>
                        <ui:Label text="Download" display-tooltip-when-elided="true" name="Label" style="white-space: nowrap; -unity-text-align: middle-center; padding-right: 0; padding-left: 0; color: rgb(255, 255, 255); position: absolute; justify-content: flex-end; left: auto; bottom: auto; align-items: center; flex-direction: row; font-size: 14px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
