<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="position: relative; height: 30px; background-image: none; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; right: auto; opacity: 1; display: flex; background-color: rgba(26, 31, 38, 0.5); flex-direction: row; justify-content: flex-start; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-top: 2px; margin-bottom: 2px; margin-right: 10px; align-items: center; overflow: hidden; border-left-color: rgb(23, 229, 71); border-right-color: rgb(23, 229, 71); border-top-color: rgb(23, 229, 71); border-bottom-color: rgb(23, 229, 71); border-left-width: 3px; -unity-font-definition: initial; -unity-font: resource(&apos;Fonts/Exo/static/Exo-Medium&apos;);">
        <ui:Label text="Text" display-tooltip-when-elided="true" name="NameLabel" style="-unity-font-style: bold; position: absolute; top: 7px; left: 12px; color: rgb(255, 255, 255);" />
        <ui:Label text="Installing..." display-tooltip-when-elided="true" name="InstallingProgressLabel" style="-unity-font-style: bold; position: absolute; top: 7px; left: auto; color: rgb(1, 199, 255); right: 5px; display: none;" />
        <ui:Label text="Description" display-tooltip-when-elided="false" name="DescriptionLabel" style="-unity-font-style: normal; position: absolute; top: 25px; left: 12px; color: rgb(255, 255, 255); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; width: auto; white-space: normal; align-items: flex-start; -unity-text-align: upper-left; display: none; right: 12px; height: auto; max-height: none; bottom: auto;" />
        <ui:VisualElement name="InfoButton" style="width: auto; height: auto; align-items: center; justify-content: center; display: flex; position: absolute; top: 0; left: 0; right: 0; bottom: 0;">
            <ui:VisualElement name="Normal" style="width: 100%; height: 100%; background-image: none; background-color: rgb(22, 116, 184); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: flex; opacity: 0;" />
            <ui:VisualElement name="Hover" style="width: 100%; height: 100%; background-image: none; background-color: rgb(22, 116, 184); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: none; border-left-color: rgb(0, 204, 255); border-right-color: rgb(0, 204, 255); border-top-color: rgb(0, 204, 255); border-bottom-color: rgb(0, 204, 255); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; opacity: 0;" />
            <ui:VisualElement name="Press" style="width: 100%; height: 100%; background-image: none; background-color: rgb(0, 204, 255); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: none; opacity: 0;" />
            <ui:Label text="Install" display-tooltip-when-elided="true" name="Label" style="color: rgb(255, 255, 255); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; font-size: 14px; -unity-text-align: upper-center; display: none;" />
        </ui:VisualElement>
        <ui:VisualElement name="ActionButton" style="width: 90px; height: 22px; align-items: center; justify-content: center; display: flex; position: absolute; top: 4px; left: auto; right: 5px;">
            <ui:VisualElement name="Normal" style="width: 100%; height: 100%; background-image: none; background-color: rgb(22, 116, 184); border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; position: absolute; display: flex;" />
            <ui:VisualElement name="Hover" style="width: 100%; height: 100%; background-image: none; background-color: rgb(22, 116, 184); border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; position: absolute; display: none; border-left-color: rgb(0, 204, 255); border-right-color: rgb(0, 204, 255); border-top-color: rgb(0, 204, 255); border-bottom-color: rgb(0, 204, 255); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;" />
            <ui:VisualElement name="Press" style="width: 100%; height: 100%; background-image: none; background-color: rgb(0, 204, 255); border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; position: absolute; display: none;" />
            <ui:Label text="Install" display-tooltip-when-elided="true" name="Label" style="color: rgb(255, 255, 255); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; font-size: 14px; -unity-text-align: middle-center; -unity-font-style: bold;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
