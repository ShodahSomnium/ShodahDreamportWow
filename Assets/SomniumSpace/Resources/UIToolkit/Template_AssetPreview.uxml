    <ui:VisualElement name="AssetPreviewTemplate" style="display: flex; width: 137px; height: 91px; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; position: relative; visibility: visible; border-right-width: 0; border-right-color: rgb(224, 75, 75); border-left-width: 0; border-top-width: 0; border-bottom-width: 0; top: auto; left: auto; margin-left: 4px; margin-right: 4px; margin-top: 4px; margin-bottom: 4px; padding-top: 0; padding-left: 0; padding-right: 0; padding-bottom: 0; flex-direction: column; flex-wrap: wrap; -unity-font-definition: initial; -unity-font: resource(&apos;Fonts/Exo/static/Exo-Medium&apos;); border-left-color: rgb(224, 75, 75); border-top-color: rgb(224, 75, 75); border-bottom-color: rgb(224, 75, 75);">
        <ui:VisualElement name="NormalState" style="position: absolute; width: 100%; height: 100%; background-color: rgba(82, 83, 102, 0.5); border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; display: flex;" />
