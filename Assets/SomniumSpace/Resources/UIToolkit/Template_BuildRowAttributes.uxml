<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="BuilderAttributeRow" style="position: relative; height: 30px; background-image: none; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; right: auto; opacity: 1; display: flex; background-color: rgba(26, 31, 38, 0.5); flex-direction: row; justify-content: flex-start; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-top: 2px; margin-bottom: 2px; margin-right: 10px; align-items: center; overflow: hidden; border-left-color: rgb(23, 229, 71); border-right-color: rgb(23, 229, 71); border-top-color: rgb(23, 229, 71); border-bottom-color: rgb(23, 229, 71); border-left-width: 3px; -unity-font-definition: initial; -unity-font: resource(&apos;Fonts/Exo/static/Exo-Medium&apos;);">
        <ui:Label text="Text" display-tooltip-when-elided="true" name="Label-Text" style="-unity-font-style: bold; position: absolute; top: 7px; left: 12px; color: rgb(255, 255, 255);" />
        <ui:Label text="Description" display-tooltip-when-elided="false" name="Label-Description" style="-unity-font-style: normal; position: absolute; top: 21px; left: 12px; color: rgb(255, 255, 255); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; width: 311px; white-space: normal; align-items: flex-start; -unity-text-align: upper-left; display: none;" />
        <ui:VisualElement name="Button" style="position: absolute; align-items: center; justify-content: center; visibility: visible; display: none; width: 100px; height: 24px; right: 10px;">
            <ui:VisualElement name="Normal" style="background-color: rgb(25, 80, 125); width: 100%; height: 100%; border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: flex; visibility: visible;" />
            <ui:VisualElement name="Hover" style="background-color: rgb(83, 138, 185); width: 100%; height: 100%; border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: none; visibility: visible;" />
            <ui:VisualElement name="Press" style="background-color: rgb(17, 53, 83); width: 100%; height: 100%; border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: flex; visibility: visible;" />
            <ui:Label text="Fix" display-tooltip-when-elided="true" name="Text" style="white-space: nowrap; -unity-text-align: middle-center; padding-right: 0; padding-left: 0; color: rgb(255, 255, 255); position: relative; justify-content: flex-end; left: auto; bottom: auto; align-items: center; flex-direction: row; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; height: 24px; width: 100px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
