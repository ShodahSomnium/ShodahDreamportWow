<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="BuilderAttributeRow" style="position: relative; height: 100px; background-image: none; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; right: auto; opacity: 1; display: flex; background-color: rgba(26, 31, 38, 0); flex-direction: row; justify-content: flex-start; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-top: 2px; margin-bottom: 12px; margin-right: 10px; align-items: center; overflow: hidden; border-left-color: rgb(230, 129, 9); border-right-color: rgb(230, 129, 9); border-top-color: rgb(230, 129, 9); border-bottom-color: rgb(230, 129, 9); border-left-width: 3px; -unity-font-definition: initial; -unity-font: resource(&quot;Fonts/Exo/static/Exo-Medium&quot;); -unity-text-align: middle-left; width: 710px;">
        <ui:Label text="Audio Source has missing Audio Clip" display-tooltip-when-elided="true" name="Title" style="-unity-font-style: bold; position: absolute; top: 0; left: 0; color: rgb(255, 255, 255); background-color: rgba(26, 31, 38, 0.5); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 5px; height: 100px; width: 200px; border-top-left-radius: 0; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 0; text-overflow: ellipsis; -unity-text-align: middle-center; align-self: auto; white-space: normal; font-size: 14px; flex-wrap: nowrap; flex-direction: column; flex-basis: auto;"/>
        <ui:ScrollView name="DescriptionScroll" horizontal-scroller-visibility="Hidden" style="top: 0; left: 210px; width: 310px; height: 100px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; padding-left: 0;">
            <ui:Label text="Audio Source on gameobject &quot;Avatar RPM Girl&quot; is empty. You need to set it up." display-tooltip-when-elided="true" name="Description" style="-unity-font-style: bold; position: relative; top: auto; left: auto; color: rgb(255, 255, 255); background-color: rgba(26, 31, 38, 0.5); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: auto; width: 300px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; -unity-text-align: middle-center; white-space: normal; text-overflow: clip; min-height: 100px;"/>
        </ui:ScrollView>
        <ui:Label display-tooltip-when-elided="true" name="InteractionBlock" style="-unity-font-style: bold; position: absolute; top: 0; left: 520px; color: rgb(255, 255, 255); background-color: rgba(26, 31, 38, 0.5); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 100px; width: 190px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; -unity-text-align: middle-center; align-items: center; justify-content: space-around;">
            <ui:VisualElement name="Button-Find" style="flex-grow: 1; width: 150px; height: 30px; justify-content: flex-end; align-self: center; top: auto; max-width: 150px; max-height: 30px; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; display: none;">
                <ui:VisualElement name="Normal" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(25, 125, 107); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; display: flex; opacity: 1; max-width: none; max-height: none; visibility: visible; overflow: visible;"/>
                <ui:VisualElement name="Hover" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(25, 125, 107); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; border-left-color: rgb(102, 255, 204); border-right-color: rgb(102, 255, 204); border-top-color: rgb(102, 255, 204); border-bottom-color: rgb(102, 255, 204); display: none; border-top-width: 1.5px; border-right-width: 1.5px; border-bottom-width: 1.5px; border-left-width: 1.5px;"/>
                <ui:VisualElement name="Press" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(102, 255, 204); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); display: none;"/>
                <ui:Label tabindex="-1" text="Find in Scene" parse-escape-sequences="true" display-tooltip-when-elided="true" style="width: 100%; height: 100%; display: flex; position: absolute;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Button-Fix" style="flex-grow: 1; width: 150px; height: 30px; justify-content: flex-end; align-self: center; top: auto; max-width: 150px; max-height: 30px; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; bottom: auto; display: none;">
                <ui:VisualElement name="Normal" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(25, 125, 107); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; display: flex; opacity: 1; max-width: none; max-height: none; visibility: visible; overflow: visible;"/>
                <ui:VisualElement name="Hover" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(25, 125, 107); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; border-left-color: rgb(102, 255, 204); border-right-color: rgb(102, 255, 204); border-top-color: rgb(102, 255, 204); border-bottom-color: rgb(102, 255, 204); display: none; border-top-width: 1.5px; border-right-width: 1.5px; border-bottom-width: 1.5px; border-left-width: 1.5px;"/>
                <ui:VisualElement name="Press" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(102, 255, 204); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); display: none;"/>
                <ui:Label tabindex="-1" text="Fix automatically" parse-escape-sequences="true" display-tooltip-when-elided="true" style="width: 100%; height: 100%; display: flex; position: absolute;"/>
            </ui:VisualElement>
        </ui:Label>
    </ui:VisualElement>
</ui:UXML>
