<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="position: relative; min-height: 54px; height: auto; flex-direction: column; flex-shrink: 0; margin-top: 3px; margin-right: 10px; margin-bottom: 3px; padding-top: 12px; padding-right: 14px; padding-bottom: 12px; padding-left: 14px; background-color: rgba(26, 31, 38, 0.64); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px; border-left-width: 3px; border-left-color: rgb(255, 255, 255); -unity-font-definition: initial; -unity-font: resource(&quot;Fonts/Exo/static/Exo-Medium&quot;); border-top-color: rgb(255, 255, 255); border-right-color: rgba(0, 0, 0, 0); border-bottom-color: rgb(255, 255, 255);">
        <ui:VisualElement name="HeaderRow" style="position: relative; min-height: 49px; height: auto; flex-direction: row; align-items: center;">
            <ui:VisualElement name="PrimaryInfo" style="min-width: 0; height: auto; flex-grow: 1; flex-shrink: 1; margin-right: 14px; flex-direction: column; justify-content: center;">
                <ui:Label text="Upload name" display-tooltip-when-elided="true" name="NameLabel" style="height: auto; min-height: 24px; padding-top: 2px; padding-right: 0; padding-bottom: 2px; padding-left: 0; color: rgb(255, 255, 255); font-size: 15px; -unity-font-style: bold; white-space: normal;"/>
                <ui:VisualElement name="MetadataRow" style="display: flex; min-height: 18px; height: auto; margin-top: 1px; flex-direction: row; align-items: center;">
                    <ui:Label text="World" display-tooltip-when-elided="true" name="CategoryLabel" style="height: auto; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgba(213, 228, 255, 0.9); font-size: 12px; -unity-font-style: bold;"/>
                    <ui:Label text="•" name="MetadataSeparator" style="height: auto; margin-right: 7px; margin-left: 7px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgba(190, 207, 235, 0.55); font-size: 12px;"/>
                    <ui:Label text="10 Sep 2026, 14:32" display-tooltip-when-elided="true" name="DateLabel" style="height: auto; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgba(190, 207, 235, 0.72); font-size: 12px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="StatusBadge" style="min-width: 96px; height: 26px; flex-shrink: 0; align-items: center; justify-content: center; padding-right: 10px; padding-left: 10px; background-color: rgba(255, 255, 255, 0.12); border-top-left-radius: 13px; border-top-right-radius: 13px; border-bottom-left-radius: 13px; border-bottom-right-radius: 13px; align-self: center;">
                <ui:Label text="Completed" display-tooltip-when-elided="true" name="StatusLabel" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; align-self: center;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ErrorContainer" style="display: none; height: auto; min-height: 36px; margin-top: 8px; padding-top: 8px; padding-right: 10px; padding-bottom: 8px; padding-left: 10px; background-color: rgba(110, 35, 45, 0.38); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;">
            <ui:Label text="Error message" display-tooltip-when-elided="false" name="ErrorMessageLabel" style="height: auto; min-height: 18px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 202, 202); font-size: 13px; white-space: normal; -unity-text-align: middle-left;"/>
        </ui:VisualElement>
        <ui:VisualElement name="AdditionalInfoRow" style="display: none; height: 30px; margin-top: 9px; flex-direction: row; justify-content: flex-end; align-items: center;">
            <ui:VisualElement name="ShowAdditionalInfoButton" style="width: 112px; height: 28px; flex-shrink: 0; align-items: center; justify-content: center; position: relative;">
                <ui:VisualElement name="Normal" style="width: 100%; height: 100%; position: absolute; display: flex; background-color: rgb(22, 116, 184); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"/>
                <ui:VisualElement name="Hover" style="width: 100%; height: 100%; position: absolute; display: none; background-color: rgb(22, 116, 184); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(0, 204, 255); border-right-color: rgb(0, 204, 255); border-top-color: rgb(0, 204, 255); border-bottom-color: rgb(0, 204, 255);"/>
                <ui:VisualElement name="Press" style="width: 100%; height: 100%; position: absolute; display: none; background-color: rgb(0, 204, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"/>
                <ui:Label text="View details" display-tooltip-when-elided="true" name="Label" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
