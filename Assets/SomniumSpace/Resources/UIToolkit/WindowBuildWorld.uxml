    <ui:VisualElement name="Root" style="padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; width: 100%; height: 100%; overflow: visible; max-width: 1024px; max-height: 1024px; -unity-font-definition: initial; -unity-font: resource(&apos;Fonts/Exo/static/Exo-Medium&apos;);">
        <ui:VisualElement name="BuildPage" style="width: 100%; height: 100%; display: flex; overflow: hidden; position: relative; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/Image_BackgroundBuild.png?fileID=2800000&amp;guid=0b233769d859ed048abbb87d80af6160&amp;type=3#Image_BackgroundBuild&quot;); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px;">
            <ui:VisualElement name="_DarkBand" style="position: absolute; width: 582px; height: 30px; top: 184px; left: 162px; background-image: none; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; right: auto; opacity: 1; display: none; background-color: rgba(29, 42, 57, 0.86); flex-direction: row; justify-content: space-around; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
