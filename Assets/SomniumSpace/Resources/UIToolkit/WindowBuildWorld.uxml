                        <ui:VisualElement name="TrueHover" style="height: 100%; width: 100%; display: none; border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; background-color: rgba(255, 204, 0, 0.35); border-left-color: rgba(255, 204, 0, 0.35); border-right-color: rgba(255, 204, 0, 0.35); border-top-color: rgba(255, 204, 0, 0.35); border-bottom-color: rgba(255, 204, 0, 0.35); border-bottom-width: 1.5px;" />
