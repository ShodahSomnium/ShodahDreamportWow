<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/SomniumSpace/Resources/UIToolkit/SomniumSDKUSS.uss?fileID=7433441132597879392&amp;guid=fd4b59a3292e5564c9b161a1820d2004&amp;type=3#SomniumSDKUSS" />
    <ui:VisualElement name="RootContainer" style="width: 600px; height: 400px; padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; background-color: rgba(255, 255, 255, 0); -unity-font-definition: initial; -unity-font: resource(&apos;Fonts/Exo/static/Exo-Medium&apos;);">
        <ui:VisualElement name="Background" style="width: 100%; height: 100%; background-color: rgb(29, 29, 42); border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px;">
            <ui:Label text="Oh no! Your world is 210 MB, we normally only allow 100 MB per user, but don&apos;t panic as we have a few options for you!" display-tooltip-when-elided="true" name="Label_Title" style="position: absolute; top: 30px; left: 30px; -unity-font-style: bold; font-size: 16px; color: rgb(0, 203, 255); align-items: center; -unity-text-align: upper-center; width: auto; right: 30px; white-space: normal;" />
            <ui:Label text="&lt;b&gt;Paid Worlds&lt;/b&gt; - If you require even more space for large complex worlds, then you always have the option to purchase a world, these can go up to 1500 MB of space." display-tooltip-when-elided="true" name="Label_BoclchainInfo" style="position: absolute; top: 110px; left: 30px; -unity-font-style: normal; font-size: 16px; color: rgb(255, 255, 255); align-items: center; -unity-text-align: upper-center; width: auto; right: 30px; white-space: normal;" />
            <ui:VisualElement name="Button_Blockchain" style="width: 200px; height: 30px; align-items: center; justify-content: center; display: flex; position: absolute; align-self: center; top: 190px;">
                <ui:VisualElement name="Normal" style="width: 100%; height: 100%; background-image: none; background-color: rgb(22, 116, 184); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: flex;" />
                <ui:VisualElement name="Hover" style="width: 100%; height: 100%; background-image: none; background-color: rgb(71, 167, 235); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: none;" />
                <ui:VisualElement name="Press" style="width: 100%; height: 100%; background-image: none; background-color: rgb(10, 58, 92); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: none;" />
                <ui:Label text="View Blockchain Worlds" display-tooltip-when-elided="true" style="color: rgb(255, 255, 255); justify-content: flex-start; align-self: auto; -unity-text-align: upper-center; padding-left: 2px;" />
            </ui:VisualElement>
            <ui:Label text="&lt;b&gt;Request verified status&lt;/b&gt; - You can request verified status by undergoing an appraisal from one of our team members in Discord. Upon approval, you&apos;ll gain access to upload up to 10 worlds with a total size limit of 300 MB." display-tooltip-when-elided="true" name="Label_BoclchainInfo" style="position: absolute; top: 240px; left: 30px; -unity-font-style: normal; font-size: 16px; color: rgb(255, 255, 255); align-items: center; -unity-text-align: upper-center; width: auto; right: 30px; white-space: normal;" />
            <ui:VisualElement name="Button_Discord" style="width: 200px; height: 30px; align-items: center; justify-content: center; display: flex; position: absolute; align-self: center; top: 340px; left: auto;">
                <ui:VisualElement name="Normal" style="width: 100%; height: 100%; background-image: none; background-color: rgb(22, 116, 184); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: flex;" />
                <ui:VisualElement name="Hover" style="width: 100%; height: 100%; background-image: none; background-color: rgb(71, 167, 235); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: none;" />
                <ui:VisualElement name="Press" style="width: 100%; height: 100%; background-image: none; background-color: rgb(10, 58, 92); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: none;" />
                <ui:Label text="Go to our Discord server" display-tooltip-when-elided="true" style="color: rgb(255, 255, 255); justify-content: flex-start; align-self: auto; -unity-text-align: upper-center; padding-left: 2px;" />
            </ui:VisualElement>
            <ui:VisualElement name="Image_SideBlue" style="position: absolute; width: 10px; height: 100%; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/ColorHighlight-Info.png?fileID=2800000&amp;guid=118a8e32b1b6bff4691c03ab486028c8&amp;type=3#ColorHighlight-Info&quot;); border-bottom-left-radius: 10px; border-top-left-radius: 10px; border-top-right-radius: 0; border-bottom-right-radius: 0;" />
            <ui:VisualElement name="Image_SideGreen" style="position: absolute; width: 10px; height: 100%; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/ColorHighlight-Success.png?fileID=2800000&amp;guid=c3b0e800af34692448dc72d813934a67&amp;type=3#ColorHighlight-Success&quot;); border-bottom-left-radius: 10px; border-top-left-radius: 10px; border-top-right-radius: 0; border-bottom-right-radius: 0; display: none;" />
            <ui:VisualElement name="Image_SideRed" style="position: absolute; width: 10px; height: 100%; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/ColorHighlight-Error.png?fileID=2800000&amp;guid=f45397f317a12924bab8ce438ed6e886&amp;type=3#ColorHighlight-Error&quot;); border-bottom-left-radius: 10px; border-top-left-radius: 10px; border-top-right-radius: 0; border-bottom-right-radius: 0; display: none;" />
            <ui:VisualElement name="Image_SideYellow" style="position: absolute; width: 10px; height: 100%; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/ColorHighlight-Warning.png?fileID=2800000&amp;guid=bf860d51531fb0240b6808393c94d81d&amp;type=3#ColorHighlight-Warning&quot;); border-bottom-left-radius: 10px; border-top-left-radius: 10px; border-top-right-radius: 0; border-bottom-right-radius: 0; display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
