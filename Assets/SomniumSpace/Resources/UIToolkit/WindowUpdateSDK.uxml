<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="RootContainer" style="padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; width: 100%; height: 100%; align-items: center; justify-content: center; -unity-font-definition: initial; -unity-font: resource(&quot;Fonts/Exo/static/Exo-Medium&quot;);">
        <ui:VisualElement name="Background" style="background-image: none; width: 610px; height: 200px; border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; background-color: rgb(27, 32, 38); opacity: 1; min-height: auto; min-width: auto;">
            <ui:VisualElement name="Exagon" style="height: 168px; width: 150px; position: absolute; top: 9px; left: 10px; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/Image_LoadingExagon.png?fileID=2800000&amp;guid=2789ac06bd6d1d247be963e33528391c&amp;type=3#Image_LoadingExagon&quot;);"/>
            <ui:VisualElement name="ExagonFull" style="height: 168px; width: 150px; position: absolute; top: 9px; left: 10px; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/Image_ExagonFull.png?fileID=2800000&amp;guid=58b4b7f04c763b2458361861d9cdf2f0&amp;type=3#Image_ExagonFull&quot;); display: none;"/>
            <ui:VisualElement name="Logo" style="background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/Icon_Somnium3Logo.png?fileID=2800000&amp;guid=a5f9a41187484384d82ffd7f14f033ff&amp;type=3#Icon_Somnium3Logo&quot;); width: 62px; height: 74px; position: absolute; top: 56px; left: 54px;"/>
            <ui:Label text="Download is complete" display-tooltip-when-elided="true" name="Lable_Title" style="position: absolute; top: 45px; left: 181px; font-size: 30px; -unity-font-style: bold; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;"/>
            <ui:VisualElement name="Button" style="width: 199px; height: 30px; align-items: center; justify-content: center; display: flex; position: absolute; top: 115px; left: 261px;">
                <ui:VisualElement name="Normal" style="width: 100%; height: 100%; background-image: none; background-color: rgb(22, 116, 184); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: flex;"/>
                <ui:VisualElement name="Hover" style="width: 100%; height: 100%; background-image: none; background-color: rgb(22, 116, 184); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: none; border-left-color: rgb(0, 204, 255); border-right-color: rgb(0, 204, 255); border-top-color: rgb(0, 204, 255); border-bottom-color: rgb(0, 204, 255); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;"/>
                <ui:VisualElement name="Press" style="width: 100%; height: 100%; background-image: none; background-color: rgb(0, 204, 255); border-top-left-radius: 16px; border-bottom-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; position: absolute; display: none;"/>
                <ui:Label text="Button" display-tooltip-when-elided="true" name="Label" style="color: rgb(255, 255, 255); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; font-size: 14px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="LoadingBar" style="position: absolute; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); background-image: none; height: 10px; display: flex; visibility: visible; width: 600px; bottom: 5px; left: 5px;">
                <ui:VisualElement name="Bar_Background" style="background-color: rgba(255, 255, 255, 0); height: 100%; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/Sphere%20Dark.png?fileID=2800000&amp;guid=1d05bcaa11108b14eb84b26ae73e80b5&amp;type=3#Sphere Dark&quot;); -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0; -unity-background-image-tint-color: rgb(59, 163, 255); border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-left-color: rgba(0, 0, 0, 0.2); border-right-color: rgba(0, 0, 0, 0.2); border-top-color: rgba(0, 0, 0, 0.2); border-bottom-color: rgba(0, 0, 0, 0.2); overflow: hidden; width: 100%; align-items: center; justify-content: center;">
                    <ui:VisualElement name="ProgressionBar" style="background-color: rgba(255, 255, 255, 0); height: 100%; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/Sphere.png?fileID=2800000&amp;guid=475a3a4883f423e47ade70c7d89c7d7e&amp;type=3#Sphere&quot;); -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0; -unity-background-image-tint-color: rgb(59, 163, 255); border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; width: 100%; border-left-color: rgba(0, 69, 118, 0.24); border-right-color: rgba(0, 69, 118, 0.24); border-top-color: rgba(0, 69, 118, 0.24); border-bottom-color: rgba(0, 69, 118, 0.24); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; margin-left: 0; overflow: visible; margin-right: 0; margin-top: 0; margin-bottom: 0; -unity-background-scale-mode: stretch-to-fill; position: relative; left: 0;">
                        <ui:VisualElement name="Animation" style="height: 100%; width: 59px; background-image: url(&quot;project://database/Assets/SomniumSpace/Resources/UIToolkit_Images/LoadingBar_Energy.png?fileID=2800000&amp;guid=2b3b95966c2fe4546a83f9824bf55cf7&amp;type=3#LoadingBar_Energy&quot;); left: -61px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Section_UpdateText" style="height: 14px; align-items: flex-end; flex-direction: row; justify-content: flex-end; padding-right: 14px; bottom: 21px; position: absolute; right: 0;">
                <ui:Label text="Somnium Space SDK - Patch Version 0.5.3" display-tooltip-when-elided="true" name="Label_VersionText" style="position: relative; padding-left: 0; padding-right: 8px; padding-top: 0; padding-bottom: 0;"/>
                <ui:Label text="SDK Version Downloaded" display-tooltip-when-elided="true" name="Label_StateText" style="position: relative; -unity-font-style: bold; color: rgb(102, 255, 204);"/>
            </ui:VisualElement>
            <ui:Label display-tooltip-when-elided="true" name="Label_SubTitle" picking-mode="Ignore" style="position: absolute; top: 82px; left: 182px; font-size: 14px; -unity-font-style: normal; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; height: 62px; width: 405px; flex-wrap: wrap-reverse; overflow: visible; white-space: normal;"/>
        </ui:VisualElement>
