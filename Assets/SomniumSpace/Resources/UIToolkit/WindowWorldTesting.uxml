<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="CustomCheckBox" src="project://database/Assets/SomniumSpace/Resources/UIToolkit/Template_CheckBox.uxml?fileID=9197481963319205126&amp;guid=70496048ccfc008448562072869aae25&amp;type=3#Template_CheckBox" />
    <Style src="project://database/Assets/SomniumSpace/Resources/UIToolkit/SomniumSDKUSS.uss?fileID=7433441132597879392&amp;guid=fd4b59a3292e5564c9b161a1820d2004&amp;type=3#SomniumSDKUSS" />
    <ui:GroupBox name="Root" style="height: 160px; width: 520px; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; display: flex; -unity-font-definition: initial; -unity-font: resource(&apos;Fonts/Exo/static/Exo-Medium&apos;);">
        <ui:VisualElement style="display: flex; width: 100%; height: 100%; background-image: none; background-color: rgb(27, 32, 38); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px;">
            <ui:Label text="Test Mode allows you to check your World in non-VR mode before uploading it to the VR client." display-tooltip-when-elided="true" style="white-space: normal; -unity-text-align: middle-left; padding-right: 0; padding-left: 0; color: rgb(255, 255, 255); position: absolute; justify-content: flex-end; left: 20px; bottom: auto; align-items: center; flex-direction: row; height: auto; font-size: 17px; top: 20px; -unity-font: resource(&apos;Fonts/Exo/static/Exo-Regular&apos;); right: 20px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-bottom: 0; -unity-font-style: bold; flex-wrap: wrap;" />
            <ui:GroupBox name="CheckBox-Autolaunch" style="position: absolute; left: 20px; top: auto; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; flex-direction: row; bottom: 50px; height: 20px;">
                <ui:Instance template="CustomCheckBox" name="CheckBox-ShowAtStartup2" style="justify-content: center;" />
                <ui:Label text="Automatically launch World testing when Play Mode starts" display-tooltip-when-elided="true" name="Label" style="white-space: nowrap; -unity-text-align: middle-left; padding-right: 0; padding-left: 5px; color: rgb(255, 255, 255);" />
            </ui:GroupBox>
            <ui:VisualElement name="Button-Documentation" style="flex-direction: row; align-items: flex-end; justify-content: flex-start; width: auto; height: 16px; left: 20px; top: auto; position: absolute; right: auto; bottom: 20px; align-self: auto; -unity-text-align: middle-left; text-overflow: clip;">
                <ui:Label text="Documentation" display-tooltip-when-elided="true" name="Normal" style="white-space: nowrap; -unity-text-align: middle-right; padding-right: 0; padding-left: 0; color: rgb(0, 204, 255); position: relative; justify-content: flex-end; left: auto; bottom: auto; align-items: center; flex-direction: row; -unity-font-style: normal; border-bottom-color: rgb(0, 204, 255); border-bottom-width: 0; margin-left: 0; top: auto; margin-right: 0; display: flex; font-size: 14px; margin-top: 0; margin-bottom: 0; align-self: center; right: auto; padding-top: 0; padding-bottom: 0;" />
                <ui:Label text="Documentation" display-tooltip-when-elided="true" name="Hover" style="white-space: nowrap; -unity-text-align: middle-right; padding-right: 0; padding-left: 0; color: rgb(196, 243, 255); position: relative; justify-content: flex-end; left: auto; bottom: auto; align-items: center; flex-direction: row; -unity-font-style: normal; border-bottom-color: rgb(196, 243, 255); border-bottom-width: 0; margin-left: 0; top: auto; margin-right: 0; display: none; visibility: visible; font-size: 14px; scale: 1.05 1.05; margin-top: 0; margin-bottom: 0; align-self: center; padding-top: 0; padding-bottom: 0; right: auto;" />
                <ui:Label text="Documentation" display-tooltip-when-elided="true" name="Press" style="white-space: nowrap; -unity-text-align: middle-right; padding-right: 0; padding-left: 0; color: rgb(5, 131, 164); position: relative; justify-content: flex-end; left: auto; bottom: auto; align-items: center; flex-direction: row; -unity-font-style: normal; border-bottom-color: rgb(5, 131, 164); border-bottom-width: 0; margin-left: 0; top: auto; margin-right: 0; display: none; visibility: visible; font-size: 14px; scale: 1 1; margin-top: 0; margin-bottom: 0; align-self: center; padding-top: 0; padding-bottom: 0; right: auto;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:GroupBox>
</ui:UXML>
